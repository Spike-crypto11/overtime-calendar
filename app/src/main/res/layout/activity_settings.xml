<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/server_url"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:hint="https://script.google.com/macros/s/.../exec"
            android:importantForAutofill="no"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apps Script 배포 후 나온 웹앱 URL(.../exec)을 붙여넣으세요."
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:paddingTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">
            <Button
                android:id="@+id/btnTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="연결 테스트"/>
            <Button
                android:id="@+id/btnSaveUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="URL 저장"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="13sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cell_border"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnManageCats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="항목 종류 관리 (색·이모지 설정)"/>

        <Button
            android:id="@+id/btnManageEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="내 일정 관리 (휴가·기념일 등)"
            android:layout_marginTop="12dp"/>

    </LinearLayout>
</ScrollView>
